cnn.vian1.tech {
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        Permissions-Policy "camera=(self), microphone=()"
    }
    # Paid phone controls stay private on the public, login-free demo.
    @phone path /safety/phone /safety/phone/*
    handle @phone {
        respond "Phone controls are available through server administration only." 403
    }
    @api path /safety /safety/* /health /predict /predict/*
    handle @api {
        reverse_proxy 127.0.0.1:8000 {
            header_up -Authorization
        }
    }
    handle {
        root * /opt/emotionlens/current/deep_fe/frontend/dist
        try_files {path} /index.html
        file_server
    }
}
